# Deployment-only credentials (never commit)
config/secrets.php

# Local runtime / editor artifacts
.agent_tmp/
.openhands/
*.log
.DS_Store

# Uploaded user content (runtime data, not source)
uploads/documents/*
uploads/evidence/*
uploads/lawyer-photos/*
uploads/knowledge/*
!uploads/**/.htaccess

# Dependency / build output
node_modules/
vendor/

# Runtime backups (created by cron/backup.php; may contain the full database dump).
# Anchored to the repository root: an unanchored `storage/` also matched
# apps/mobile/lib/core/storage/, which silently kept token_storage.dart out of git and
# left the Flutter app unbuildable from a fresh clone.
/storage/

# Browser test output (screenshots, traces, HTML report)
tests/e2e/.artifacts/

