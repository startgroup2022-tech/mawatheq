# منصة مواثيق — إعدادات الأمان الأساسية لاستضافة cPanel

# منع عرض محتويات المجلدات
Options -Indexes

# Preserve the Authorization header for the Bearer-token REST API (/api/v1).
# Under mod_php/CGI Apache drops it before PHP runs, which makes every API call
# return 401 in production. Exposing it via mod_rewrite also sets REDIRECT_HTTP_AUTHORIZATION.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Enforce HTTPS for the production host while preserving the requested path/query.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?mawatheq\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# منع الوصول المباشر لملفات الإعداد وقاعدة البيانات والملفات المخفية
<FilesMatch "(^\.|\.(sql|md|env|log|ini)$|^secrets\.php$)">
    Require all denied
</FilesMatch>

# أرشيفات الإصدار: خطوات النشر ترفع MAWATHEQ_WEBSITE_FINAL.zip إلى public_html ثم تفكّه.
# إن بقي الملف بعد الفكّ صار قابلاً للتنزيل العام، فيكشف شجرة الموقع كاملة. لا يخدم الموقع
# أي أرشيف من جذر الويب (تقارير CSV والمرفقات تُرسل من مسارات PHP لا كملفات)، فمنعها آمن.
<FilesMatch "\.(zip|tar|tgz|gz|rar|7z|bz2|apk|ipa)$">
    Require all denied
</FilesMatch>

# ملفات البناء ومديري الحزم وبيانات الاختبار: تكشف إصدارات المكتبات وأدوات التطوير.
# نُسمّيها صراحةً بدل منع كل ملفات .json، لأن .well-known/assetlinks.json وملف
# تطبيق الجوال (manifest.json) يجب أن يبقيا متاحين للعامة.
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|playwright\.config\.js|phpunit\.xml(\.dist)?|\.editorconfig)$">
    Require all denied
</FilesMatch>

# مجلدات المصدر والإعداد لا تحتاج استقبال طلبات HTTP مباشرة
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|database|includes|tests|tools|vendor|storage|node_modules|apps)/ - [F,L,NC]
    # Block the whole version-control directory: FilesMatch (^\.) only matches a file's own
    # name, so nested files like .git/config bypassed it and exposed history and remote creds.
    RewriteRule ^\.git(?:/|$) - [F,L,NC]
    RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|asp|aspx)$ - [F,L,NC]

    # Canonical trailing-slash URLs for the legal pages. Google Play's account-deletion
    # requirement names a URL, and /delete-account/ has to reach the real page rather
    # than the DirectoryIndex fallback — with no rule here the request for a directory
    # that does not exist was answered by index.php, so the page returned HTTP 200 with
    # the homepage's body and looked healthy while never being reachable. The rewrite
    # targets the .php file directly and keeps the trailing slash, so one canonical URL
    # serves the content.
    RewriteRule ^(privacy|delete-account)/?$ $1.php [L,NC]
</IfModule>

# توجيه أخطاء 404 (اختياري - أنشئ الملف عند الحاجة)
# ErrorDocument 404 /404.php

# تفعيل ضغط الصفحات
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
