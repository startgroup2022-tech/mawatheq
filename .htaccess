# منصة مواثيق — إعدادات الأمان الأساسية لاستضافة cPanel

# منع عرض محتويات المجلدات
Options -Indexes

# Preserve the Authorization header for the Bearer-token REST API (/api/v1).
# Under mod_php/CGI Apache drops it before PHP runs, which makes every API call
# return 401 in production. Exposing it via mod_rewrite also sets REDIRECT_HTTP_AUTHORIZATION.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Enforce HTTPS for the production host while preserving the requested path/query.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?mawatheq\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# منع الوصول المباشر لملفات الإعداد وقاعدة البيانات والملفات المخفية
<FilesMatch "(^\.|\.(sql|md|env|log|ini)$|^secrets\.php$)">
    Require all denied
</FilesMatch>

# مجلدات المصدر والإعداد لا تحتاج استقبال طلبات HTTP مباشرة
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|database|includes|tests)/ - [F,L,NC]
    # Block the whole version-control directory: FilesMatch (^\.) only matches a file's own
    # name, so nested files like .git/config bypassed it and exposed history and remote creds.
    RewriteRule ^\.git(?:/|$) - [F,L,NC]
    RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|asp|aspx)$ - [F,L,NC]
</IfModule>

# توجيه أخطاء 404 (اختياري - أنشئ الملف عند الحاجة)
# ErrorDocument 404 /404.php

# تفعيل ضغط الصفحات
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
